{
  "name": "pi-counsel",
  "version": "0.1.0",
  "description": "Give your Pi agent a counsel tool: a stronger model it consults before committing to an approach, when stuck, or before declaring done.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "advisor",
    "counsel",
    "second-opinion"
  ],
  "license": "MIT",
  "author": "Vieko Franetovic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vieko/pi-counsel.git"
  },
  "type": "module",
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "gate": "npm run check && npm test"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-counsel/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@types/node": "^24",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
